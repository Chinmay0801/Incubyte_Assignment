# Port the API listens on
PORT=4000
# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/dealership.db
# Secret used to sign JWTs - CHANGE THIS in any real deployment
JWT_SECRET=change-me-to-a-long-random-string
# How long issued tokens stay valid
JWT_EXPIRES_IN=1d
# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173
# Default admin account created on startup if it does not exist
ADMIN_EMAIL=admin@dealership.com
ADMIN_PASSWORD=Admin@123
